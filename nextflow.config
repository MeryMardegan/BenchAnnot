params {
    // Base directory for InterProScan data files.
    ips_data_dir = "${projectDir}/data/eukaryotes/db/interproscan/interproscan-5.75-106.0/data"

    // Primary output formats for InterProScan.
    ips_formats= 'tsv,gff3'   // formatos de saída principais

    // EggNOG database location (if not bundled in the container image).
    emmapper_data_dir = "${projectDir}/data/eukaryotes/db/eggnog"

    bakta_db_dir = null
    eggnog_db_dir = null
    pgap_dir = null
}

process {
    executor = 'slurm'         
    cpus = 10
    memory = '32 GB'
    time = '72h'
    queue = 'SP2'  // ajuste conforme sistema
    queueSize = 10
    beforeScript = 'module load apptainer/1.3.1 || true' // ajuste conforme sistema
    env = [
        // Shared Apptainer cache to avoid repeated pulls.
        'APPTAINER_CACHEDIR': "${projectDir}/apptainer_cache/.layer_cache",
        'APPTAINER_TMPDIR': "${projectDir}/apptainer_cache/tmp",
        'NXF_APPTAINER_CACHEDIR': "${projectDir}/apptainer_cache/.layer_cache"
        TMPDIR = "${projectDir}/tmp"
    ]

    // // Tool-specific configuration.
    withLabel: kofamscan {
    container = "${projectDir}/apptainer_cache/kofamscan_1.3.0--0.sif"
    }

    withLabel: gffread {
    container = 'quay.io/biocontainers/gffread:0.12.7--h9a82719_0'
    }

    withLabel: interproscan {
    container = 'interpro/interproscan:5.75-106.0'
    // Bind the InterProScan data directory into the container.
    containerOptions = "--bind ${params.ips_data_dir}:/opt/interproscan/data"
    }

    withLabel: eggnog_mapper_v2 {
    container = "${projectDir}/apptainer_cache/eggnog_v2:2.1.13-sse41"
        beforeScript = """
    mkdir -p "${params.emmapper_data_dir}"
    """
    containerOptions = "--bind ${params.emmapper_data_dir}:/eggnog-data:ro"
    env = [
        'EGGNOG_DATA_DIR': '/eggnog-data',
        'NXT_TASK_MONITOR': '0'
    ]
    }

    withName: EGGNOG {
        memory = '128 GB'
        time = '24h'
    }

    withName: BAKTA {
        memory = '128 GB'
        time = '24h'
    }

    withName: PROKKA {
        memory = '64 GB'
        time = '24h'
    }

}

singularity {
    enabled = true
    autoMounts = true
    // Image cache for Apptainer/Singularity.
    cacheDir = "$projectDir/apptainer_cache/.layer_cache"
}