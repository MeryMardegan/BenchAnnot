params {
    // ============================================================================
    // Pipeline parameters
    // ============================================================================

    // ---------------------------------------------------------------------------
    // Workflow inputs and outputs
    // ---------------------------------------------------------------------------

    annotation_type = 'both'
    prokaryote_samplesheet = "${projectDir}/assets/prokaryote_samplesheet.csv"
    eukaryote_samplesheet = "${projectDir}/assets/eukaryote_samplesheet.csv"
    outdir = "${projectDir}/data/reproduced"

    // ---------------------------------------------------------------------------
    // Database images
    // ---------------------------------------------------------------------------

    // Annotation processes consume external databases as read-only SquashFS images.

    // Example: --bakta_db /path/to/bakta_<release>.sqsh
    bakta_db = null
    bakta_db_version = '6.0'
    bakta_db_md5 = '4c1115e40abfa2b464ae5dd988bdd88e'

    // Bundle this pinned AMRFinderPlus release into the Bakta image.
    bakta_amrfinder_db_series = '4.0'
    bakta_amrfinder_db_version = '2025-07-16.1'

    // Build the pinned KofamScan release when no external image is provided.
    kofamscan_db = null
    kofamscan_db_release = '2026-07-02'

    // Build the matching InterProScan data image when no image is provided.
    ips_db = null
    interproscan_version = '5.75-106.0'

    // Use this eggNOG image when valid; otherwise create it at the same path.
    eggnog_db = "${projectDir}/data/database/eggnog/eggnog_2026-09.sqsh"

    // ---------------------------------------------------------------------------
    // PGAP runtime
    // ---------------------------------------------------------------------------

    // pgap.py manages its own runtime and container instead of a SquashFS database.
    pgap_version = '2026-06-18.build8602'
    pgap_python_version = '3.11'
    pgap_python_dir = "${projectDir}/data/runtime/pgap-python-3.11"
    pgap_dir = "${projectDir}/data/database/pgap"
    pgap_container = "${projectDir}/data/database/pgap/pgap_2026-06-18.build8602.sif"

    // ---------------------------------------------------------------------------
    // Tool options
    // ---------------------------------------------------------------------------

    ips_formats = 'tsv,gff3'
}

// ============================================================================
// Environment passed to workflow tasks
// ============================================================================

env {
    NXT_TASK_MONITOR = '0'
}

process {
    // ============================================================================
    // Process resources and containers
    // ============================================================================

    // ---------------------------------------------------------------------------
    // Default HPC resources
    // ---------------------------------------------------------------------------

    executor = 'slurm'
    queue = 'SP2'
    cpus = 10
    memory = 128.GB
    time = 24.h
    // ---------------------------------------------------------------------------
    // Prokaryotic annotation
    // ---------------------------------------------------------------------------

    withLabel: prokka {
        container = 'https://depot.galaxyproject.org/singularity/prokka%3A1.14.6--pl5321hdfd78af_5'
        memory = 64.GB
        time = 24.h
    }

    withLabel: bakta_prepare {
        container = 'oschwengers/bakta:v1.11.3'
        containerOptions = { "-B ${cache_dir}:${cache_dir}" }
        cpus = 1
        memory = 128.GB
        time = 72.h
    }
    withLabel: bakta {
        container = 'oschwengers/bakta:v1.11.3'
        // Mount the database image at Bakta's expected read-only root.
        containerOptions = { "-B ${bakta_db}:/database:image-src=/" }
        memory = 128.GB
        time = 24.h
    }

    withLabel: pgap_python_prepare {
        cpus = 1
        memory = 8.GB
        time = 1.h
    }

    withLabel: pgap {
        // pgap.py launches the configured PGAP container itself.
        memory = 128.GB
        time = 24.h
    }

    withLabel: eggnog_prepare {
        container = 'brunoholiva/eggnog_v2:2.1.13-sse41'
        memory = 128.GB
        time = 72.h
        cpus = 2
    }

    withLabel: eggnog_mapper_v2 {
        container = 'brunoholiva/eggnog_v2:2.1.13-sse41'
        // Both annotation branches mount the shared database at the same root.
        containerOptions = { "-B ${eggnog_db}:/database:image-src=/" }
        memory = 128.GB
        time = 24.h
        // Preserved to tolerate transient container/cache failures.
        errorStrategy = 'retry'
        maxRetries = 1
    }

    // ---------------------------------------------------------------------------
    // Eukaryotic preprocessing and annotation
    // ---------------------------------------------------------------------------

    withLabel: gffread { container = 'quay.io/biocontainers/gffread:0.12.7--h9a82719_0' }

    withLabel: kofamscan_prepare {
        cpus = 1
        memory = 4.GB
        time = 24.h
    }

    withLabel: kofamscan {
        container = 'docker://quay.io/biocontainers/kofamscan:1.3.0--hdfd78af_2'
        // The image root contains the profiles directory and ko_list file.
        containerOptions = { "-B ${kofam_db}:/database:image-src=/" }
        memory = 128.GB
        time = 24.h
    }

    withLabel: interproscan_prepare {
        container = 'docker://python:3.11-bookworm'
        cpus = 1
        memory = 8.GB
        time = 48.h

        containerOptions = { "-B ${cache_dir}:${cache_dir}" }
    }

    withLabel: interproscan {
        container = 'interpro/interproscan:5.75-106.0'
        // Mount the image where InterProScan expects its data directory.
        containerOptions = { "-B ${ips_db}:/opt/interproscan/data:image-src=/" }
        cpus = 10
        memory = 128.GB
        time = 24.h
    }

    // ---------------------------------------------------------------------------
    // Database packaging
    // ---------------------------------------------------------------------------

    withLabel: squashfs_tools {
        // Keep mksquashfs independent from annotation-tool containers.
        container = 'docker://merymardegan/squashfs-tools:4.6.1-ubuntu24.04'
        cpus = 10
        memory = 32.GB
        time = 24.h
    }
}

// ============================================================================
// Apptainer
// ============================================================================

singularity {
    enabled = true
    autoMounts = true
    cacheDir = "${projectDir}/apptainer_cache"
}
