params {
    // ============================================================
    // Workflow
    // ============================================================

    annotation_type = 'both'
    prokaryote_samplesheet = "${projectDir}/assets/prokaryote_samplesheet.csv"
    eukaryote_samplesheet = "${projectDir}/assets/eukaryote_samplesheet.csv"
    outdir = "${projectDir}/data/reproduced"

    // ============================================================
    // Database images
    // ============================================================
    //External databases are provided to annotation processes as read-only SquashFS images.

    // Example: --bakta_db /path/to/bakta_<release>.sqsh
    bakta_db = null

    // KofamScan database image. Example: --kofamscan_db /path/to/kofamscan_<release>.sqsh
    kofamscan_db = null

    // InterProScan data image.
    ips_db = "${projectDir}/data/database/interproscan/interproscan_5.75-106.0.sqsh"

    /*
     * eggNOG is special:
     * RESOLVE_EGGNOG_DB uses this image when it exists.
     * Otherwise PREPARE_EGGNOG + PACK_SQUASHFS create it.
     */
    eggnog_db = "${projectDir}/data/database/eggnog/eggnog_2026-09.sqsh"

    // ============================================================
    // PGAP
    // ============================================================

    // PGAP is not handled as a SquashFS database resource. pgap.py manages its own container execution.
    pgap_dir = null
    pgap_container = null

    // ============================================================
    // InterProScan
    // ============================================================
    ips_formats = 'tsv,gff3'
}

// ============================================================
// Environment passed to workflow tasks
// ============================================================

env {
    TMPDIR = "${projectDir}/tmp"
    NXT_TASK_MONITOR = '0'
}

process {
    // --------------------------------------------------------------------
    // Default HPC resources
    // --------------------------------------------------------------------
    executor = 'slurm'
    queue = 'SP2'
    cpus = 10
    memory = 128.GB
    time = 24.h

    // ====================================================================
    // Prokaryotic annotation
    // ====================================================================

    // --------------------------------------------------------------------
    // Prokka
    // --------------------------------------------------------------------

    withLabel: prokka {
        container = 'https://depot.galaxyproject.org/singularity/prokka%3A1.14.6--pl5321hdfd78af_5'
        memory = 64.GB
        time = 24.h
    }

    // --------------------------------------------------------------------
    // Bakta
    // --------------------------------------------------------------------

    withLabel: bakta {
        container = 'oschwengers/bakta:v1.11.3'
        //bakta_db is the process input: path bakta_db
        containerOptions = {"-B ${bakta_db}:/database:image-src=/"}
        memory = 128.GB
        time = 24.h
    }

    // --------------------------------------------------------------------
    // PGAP
    // --------------------------------------------------------------------

    withLabel: pgap {
        //No Nextflow container here  pgap.py itself invokes the PGAP container using: --container-path ${pgap_container
        memory = 128.GB
        time = 24.h
    }
    // ====================================================================
    // eggNOG
    // ====================================================================
    // --------------------------------------------------------------------
    // eggNOG database preparation
    // --------------------------------------------------------------------
    withLabel: eggnog_prepare {
        // PREPARE_EGGNOG downloads the database.
        container = 'brunoholiva/eggnog_v2:2.1.13-sse41'
        memory = 128.GB
        time = 24.h
    }
    // --------------------------------------------------------------------
    // eggNOG annotation
    // --------------------------------------------------------------------

    withLabel: eggnog_mapper_v2 {
        container = 'brunoholiva/eggnog_v2:2.1.13-sse41'
        // eggnog_db is a formal path input of EGGNOG_PROKARYOTE and EGGNOG_EUKARYOTE.
        containerOptions = {"-B ${eggnog_db}:/database:image-src=/"}
        memory = 128.GB
        time = 24.h
        // Preserved to tolerate transient container/cache failures.
        errorStrategy = 'retry'
        maxRetries = 1
    }

    // ====================================================================
    // Eukaryotic preprocessing / annotation
    // ====================================================================

    // --------------------------------------------------------------------
    // GFFread
    // --------------------------------------------------------------------
    withLabel: gffread { container = 'quay.io/biocontainers/gffread:0.12.7--h9a82719_0'}

    // --------------------------------------------------------------------
    // KofamScan
    // --------------------------------------------------------------------

    withLabel: kofamscan {
        container = "${projectDir}/apptainer_cache/kofamscan_1.3.0--0.sif"
        /*
         * kofam_db is the path input declared by KOFAMSCAN.
         *
         * The SquashFS root contains:
         *
         * /profiles
         * /ko_list
         */
        containerOptions = {"-B ${kofam_db}:/database:image-src=/"}
        memory = 128.GB
        time = 24.h
    }
    // --------------------------------------------------------------------
    // InterProScan
    // --------------------------------------------------------------------

    withLabel: interproscan {
        container = 'interpro/interproscan:5.75-106.0'
        // ips_db is the process path input. The SquashFS image is mounted where InterProScan expects its data directory.
        containerOptions = {"-B ${ips_db}:/opt/interproscan/data:image-src=/"}
        cpus = 10
        memory = 128.GB
        time = 24.h
    }
    // ====================================================================
    // Database packaging
    // ====================================================================

    withLabel: squashfs_tools {
        /*
         * Dedicated container for PACK_SQUASHFS. 
         * Keep this separate from annotation containers so individual tools do not need to provide mksquashfs themselves.
         */
        container = 'docker.io/gabrielstedman/squashfs-tools:4.6.1-alpine'
        cpus = 10
        memory = 32.GB
        time = 24.h
    }
}

// ========================================================================
// Apptainer
// ========================================================================

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = "${projectDir}/apptainer_cache"
}