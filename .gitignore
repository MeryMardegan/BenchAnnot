__pycache__/
*.pyc
*.egg-info/
.opencode/
**/2_run/output/
**/2_run/tmp/
.venv/
.vscode/

# Data files are intentionally versionable. Git tracks files, not empty
# directories; add a .gitkeep file when an empty directory must be preserved.

# Ignore only generated top-level directories, not project data directories.
/databases/
/results/
*.out
*.log

# Large local reference genomes are not committed.
/data/genome_eukaryote/*
!/data/genome_eukaryote/.gitkeep
/data/genome_prokaryote/*
!/data/genome_prokaryote/.gitkeep

# Original tool outputs are local benchmark data. Keep only directory markers.
/data/origin/*
!/data/origin/**/
!/data/origin/**/.gitkeep

# Environments
.env
*.Rhistory

# Nextflow
work/
.nextflow
