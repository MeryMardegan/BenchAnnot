# Local biological data and generated pipeline resources are never committed.
# Keep only directory markers so the expected structure remains versioned.
/data/**
!/data/**/
!/data/**/.gitkeep

# Ignore only generated top-level directories, not project data directories.
/databases/
/results/
*.out
*.log

# Environments
.env
*.Rhistory

# Nextflow
work/
.nextflow

# Nextflow runtime files
.nextflow*
*.pid

# Local container cache
/apptainer_cache/

# Editor / temporary backups
*.save

# Local test suites and fixtures
/tests/
/analysis_benchannot/tests/
/teste.sqsh
/teste_db/
